<Application x:Class="Headroom.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Headroom.App.Views"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!--
          Slot 0 is the palette and is replaced at runtime by ThemeManager.
          Everything after it references the palette through DynamicResource, so
          a theme change needs no rebuild of the styles.
        -->
        <ResourceDictionary Source="Theme/Palette.Dark.xaml" />
        <ResourceDictionary Source="Theme/Controls.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <views:BoolToVisibilityConverter x:Key="BoolToVisibility" />
      <views:StringToVisibilityConverter x:Key="StringToVisibility" />
      <views:InverseBooleanConverter x:Key="InverseBoolean" />
      <views:EqualityConverter x:Key="Equality" />
      <views:IntervalLabelConverter x:Key="IntervalLabel" />
      <views:ProviderIndexConverter x:Key="ProviderIndex" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
