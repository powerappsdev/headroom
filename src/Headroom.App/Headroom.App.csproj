<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!--
      WPF draws everything; Windows Forms is here for exactly one type,
      NotifyIcon, which is still the most reliable way to own a tray icon and
      show a shell notification without taking a package dependency.
    -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Headroom.App</RootNamespace>
    <AssemblyName>Headroom</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\headroom.ico</ApplicationIcon>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Headroom.Core\Headroom.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\headroom.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
