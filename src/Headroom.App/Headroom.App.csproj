<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!--
      WPF draws everything; Windows Forms is here for exactly one type,
      NotifyIcon, which is still the most reliable way to own a tray icon and
      show a shell notification without taking a package dependency.
    -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Headroom.App</RootNamespace>
    <AssemblyName>Headroom</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\headroom.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <SelfContained>false</SelfContained>
    <!--
      WFO0003 tells WinForms apps to set high-DPI mode through
      Application.SetHighDpiMode instead of the manifest. This is a WPF app that
      enables WinForms only for NotifyIcon; WPF reads per-monitor v2 awareness
      from the manifest at process start, and that awareness is what keeps the
      deck positioned correctly against the tray on a mixed-DPI desktop.
    -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Headroom.Core\Headroom.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\headroom.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
