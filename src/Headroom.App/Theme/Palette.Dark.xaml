<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Dark is a selected palette, not an inverted light one. Every step below was
    chosen against the #1a1a19 surface and validated as a set, which is why the
    series hues differ from their light-mode counterparts rather than simply
    brightening.
  -->

  <Color x:Key="SurfaceColor">#FF1A1A19</Color>
  <Color x:Key="SurfaceElevatedColor">#FF232322</Color>
  <Color x:Key="SurfaceHoverColor">#FF2B2B29</Color>
  <Color x:Key="HairlineColor">#FF2C2C2A</Color>
  <Color x:Key="TextPrimaryColor">#FFFFFFFF</Color>
  <Color x:Key="TextSecondaryColor">#FFC3C2B7</Color>
  <Color x:Key="TextMutedColor">#FF898781</Color>
  <Color x:Key="TrackColor">#FF34342F</Color>

  <!-- Status: fixed, never themed, and never used for a data series. -->
  <Color x:Key="MeterHealthyColor">#FF3987E5</Color>
  <Color x:Key="MeterWarningColor">#FFFAB219</Color>
  <Color x:Key="MeterCriticalColor">#FFD03B3B</Color>
  <Color x:Key="MeterUnknownColor">#FF56564F</Color>

  <!-- Categorical slots for the history chart, in fixed order. -->
  <Color x:Key="Series1Color">#FF3987E5</Color>
  <Color x:Key="Series2Color">#FFD95926</Color>
  <Color x:Key="Series3Color">#FF199E70</Color>
  <Color x:Key="Series4Color">#FFC98500</Color>

  <Color x:Key="AccentColor">#FF3987E5</Color>
  <Color x:Key="ClaudeMarkColor">#FFD97757</Color>
  <Color x:Key="CodexMarkColor">#FFE8E8E4</Color>

  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
  <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource TrackColor}" />
  <SolidColorBrush x:Key="MeterHealthyBrush" Color="{StaticResource MeterHealthyColor}" />
  <SolidColorBrush x:Key="MeterWarningBrush" Color="{StaticResource MeterWarningColor}" />
  <SolidColorBrush x:Key="MeterCriticalBrush" Color="{StaticResource MeterCriticalColor}" />
  <SolidColorBrush x:Key="MeterUnknownBrush" Color="{StaticResource MeterUnknownColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="ClaudeMarkBrush" Color="{StaticResource ClaudeMarkColor}" />
  <SolidColorBrush x:Key="CodexMarkBrush" Color="{StaticResource CodexMarkColor}" />

</ResourceDictionary>
