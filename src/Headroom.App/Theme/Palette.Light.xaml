<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Light mode. Same key names as the dark dictionary so the whole theme swaps by
    replacing one merged dictionary at runtime.

    Note the meter status colours are identical in both modes: status colour is
    reserved and never themed. On this lighter surface, warning sits below a 3:1
    contrast ratio on purpose - the mitigation is that a meter never carries
    meaning alone. Every bar is accompanied by its window label and its "% left"
    number, and the track is drawn with a hairline edge so the fill boundary
    stays locatable even where the fill itself is pale.
  -->

  <Color x:Key="SurfaceColor">#FFFCFCFB</Color>
  <Color x:Key="SurfaceElevatedColor">#FFFFFFFF</Color>
  <Color x:Key="SurfaceHoverColor">#FFF2F1EC</Color>
  <Color x:Key="HairlineColor">#FFE1E0D9</Color>
  <Color x:Key="TextPrimaryColor">#FF0B0B0B</Color>
  <Color x:Key="TextSecondaryColor">#FF52514E</Color>
  <Color x:Key="TextMutedColor">#FF898781</Color>
  <Color x:Key="TrackColor">#FFE8E7E0</Color>

  <Color x:Key="MeterHealthyColor">#FF2A78D6</Color>
  <Color x:Key="MeterWarningColor">#FFFAB219</Color>
  <Color x:Key="MeterCriticalColor">#FFD03B3B</Color>
  <Color x:Key="MeterUnknownColor">#FFCBCAC2</Color>

  <Color x:Key="Series1Color">#FF2A78D6</Color>
  <Color x:Key="Series2Color">#FFEB6834</Color>
  <Color x:Key="Series3Color">#FF1BAF7A</Color>
  <Color x:Key="Series4Color">#FFEDA100</Color>

  <Color x:Key="AccentColor">#FF2A78D6</Color>
  <Color x:Key="ClaudeMarkColor">#FFD97757</Color>
  <Color x:Key="CodexMarkColor">#FF1F1F1D</Color>

  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
  <SolidColorBrush x:Key="HairlineBrush" Color="{StaticResource HairlineColor}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="TrackBrush" Color="{StaticResource TrackColor}" />
  <SolidColorBrush x:Key="MeterHealthyBrush" Color="{StaticResource MeterHealthyColor}" />
  <SolidColorBrush x:Key="MeterWarningBrush" Color="{StaticResource MeterWarningColor}" />
  <SolidColorBrush x:Key="MeterCriticalBrush" Color="{StaticResource MeterCriticalColor}" />
  <SolidColorBrush x:Key="MeterUnknownBrush" Color="{StaticResource MeterUnknownColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="ClaudeMarkBrush" Color="{StaticResource ClaudeMarkColor}" />
  <SolidColorBrush x:Key="CodexMarkBrush" Color="{StaticResource CodexMarkColor}" />

</ResourceDictionary>
